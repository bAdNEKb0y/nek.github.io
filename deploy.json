{"name": "footdepoche", "project": "prj_PJ2rxn0zn4sofCkkjuuQkof6Mc4k", "target": "production", "projectSettings": {"framework": null}, "files": [{"file": "vercel.json", "encoding": "utf-8", "data": "{\"rewrites\": [{\"source\": \"/v/:sha/:file(.+)\", \"destination\": \"https://cdn.jsdelivr.net/gh/bAdNEKb0y/nek.github.io@:sha/:file\"}, {\"source\": \"/:file(.+\\\\..+)\", \"destination\": \"https://cdn.jsdelivr.net/gh/bAdNEKb0y/nek.github.io@5a346f9bcb35bd2cf528128e95a42f4ed95481bd/:file\"}], \"headers\": [{\"source\": \"/\", \"headers\": [{\"key\": \"Cache-Control\", \"value\": \"no-cache\"}]}, {\"source\": \"/index.html\", \"headers\": [{\"key\": \"Cache-Control\", \"value\": \"no-cache\"}]}, {\"source\": \"/sw.js\", \"headers\": [{\"key\": \"Cache-Control\", \"value\": \"no-cache\"}]}, {\"source\": \"/manifest.webmanifest\", \"headers\": [{\"key\": \"Cache-Control\", \"value\": \"no-cache\"}]}]}"}, {"file": "index.html", "encoding": "utf-8", "data": "<!doctype html>\n<html lang=\"fr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no\">\n<meta name=\"theme-color\" content=\"#0b1411\">\n<meta name=\"mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">\n<title>Foot de Poche Online</title>\n<link rel=\"manifest\" href=\"manifest.webmanifest\">\n<link rel=\"icon\" href=\"icon.svg\" type=\"image/svg+xml\">\n<link rel=\"apple-touch-icon\" href=\"apple-touch-icon.png\">\n<meta name=\"apple-mobile-web-app-title\" content=\"Foot de Poche\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Saira+Extra+Condensed:wght@600;800&family=Barlow:wght@400;600;700&display=swap\">\n<link rel=\"stylesheet\" href=\"v/5a346f9bcb35bd2cf528128e95a42f4ed95481bd/styles.css\">\n</head>\n<body>\n<div id=\"app\">\n\n  <!-- Connexion -->\n  <section id=\"auth\" class=\"screen\" hidden>\n    <div class=\"split\">\n      <div class=\"brand\">\n        <div class=\"kicker\">Foot 2D · 5 contre 5 · en ligne</div>\n        <h1>FOOT<br><span>DE POCHE</span></h1>\n        <p class=\"lede\">Joue contre ton pote en direct, chacun sur son téléphone. Choisis ton club, monte au classement.</p>\n      </div>\n      <form class=\"card authcard\" id=\"authForm\" novalidate>\n        <div class=\"seg\" role=\"tablist\">\n          <button type=\"button\" role=\"tab\" data-mode=\"login\" aria-selected=\"true\">Connexion</button>\n          <button type=\"button\" role=\"tab\" data-mode=\"signup\" aria-selected=\"false\">Créer un compte</button>\n        </div>\n        <label for=\"uName\">Pseudo</label>\n        <input id=\"uName\" autocomplete=\"username\" maxlength=\"16\" spellcheck=\"false\" autocapitalize=\"off\" placeholder=\"3 à 16 lettres, chiffres ou _\">\n        <label for=\"uPass\">Mot de passe</label>\n        <input id=\"uPass\" type=\"password\" autocomplete=\"current-password\" maxlength=\"72\" placeholder=\"6 caractères minimum\">\n        <p class=\"err\" id=\"authErr\" role=\"alert\"></p>\n        <button class=\"btn primary\" id=\"authGo\" type=\"submit\">Se connecter</button>\n        <p class=\"hint\" id=\"authHint\">Ton compte reste connecté sur ce téléphone.</p>\n      </form>\n    </div>\n  </section>\n\n  <!-- Accueil -->\n  <section id=\"home\" class=\"screen\" hidden>\n    <header class=\"topbar\">\n      <div class=\"logo\">FOOT <span>DE POCHE</span></div>\n      <div class=\"hdr-right\"><button class=\"adminbtn\" id=\"bAdmin\" hidden aria-label=\"Panel admin\" title=\"Panel admin\">🛠<span class=\"adb\" id=\"adminBadge\" hidden></span></button><span class=\"coins\" id=\"coinsHome\" title=\"Pièces\"></span><div class=\"me\" id=\"meCard\" role=\"button\" tabindex=\"0\" aria-label=\"Mon profil\" title=\"Mon profil\"></div><button class=\"gear\" id=\"bSettings\" aria-label=\"Paramètres\" title=\"Paramètres\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm8.6-2.1-.1-2.8 2-1.6-2-3.4-2.4.9-2.4-1.4-.4-2.6h-4l-.4 2.6-2.4 1.4-2.4-.9-2 3.4 2 1.6-.1 2.8-1.9 1.6 2 3.4 2.4-.9 2.4 1.4.4 2.6h4l.4-2.6 2.4-1.4 2.4.9 2-3.4Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/></svg></button></div>\n    </header>\n    <div class=\"homegrid\">\n      <div class=\"col\">\n        <button class=\"play-tile\" id=\"bQuick\"><small>En ligne</small><b>Partie rapide</b><span id=\"quickTxt\">Trouve un adversaire au hasard</span></button>\n        <div class=\"row2\">\n          <button class=\"tile\" id=\"bCreate\"><b>Créer une salle</b><span>Donne le code à ton pote</span></button>\n          <form class=\"tile join\" id=\"joinForm\"><b>Rejoindre</b><div class=\"joinrow\"><input id=\"joinCode\" maxlength=\"4\" placeholder=\"CODE\" autocapitalize=\"characters\" spellcheck=\"false\" aria-label=\"Code de la salle\"><button class=\"btn small\" type=\"submit\">OK</button></div></form>\n        </div>\n        <div class=\"row2\">\n          <button class=\"tile club\" id=\"bClub\"><b>Mon équipe</b><span id=\"clubTxt\">Crée ton équipe avec tes cartes</span></button>\n          <button class=\"tile packs\" id=\"bShop\"><b>Packs</b><span id=\"shopTxt\">Ouvre des packs, trouve des légendes</span></button>\n        </div>\n        <p class=\"hint\">Duel de packs 1 contre 1 : crée une salle, puis choisis le mode « Duel de packs ».</p>\n        <button class=\"tile wide\" id=\"bSolo\"><b>Entraînement contre l'ordi</b><span>Gagne des pièces contre l'ordi</span></button>\n        <button class=\"tile wide tuto-tile\" id=\"bTuto\"><b>Comment jouer ?</b><span>Le tuto en 9 écrans : passes, tirs, retournées, manette</span></button>\n        <p class=\"err\" id=\"homeErr\" role=\"alert\"></p>\n      </div>\n      <div class=\"col\">\n        <div class=\"card\">\n          <div class=\"cardhead\"><h2>Amis <i class=\"badge\" id=\"friendsBadge\" hidden></i></h2><span class=\"muted fcount\" id=\"friendsCount\"></span><button class=\"btn small\" id=\"bTrades\">🔄 Échanges <i class=\"badge\" id=\"tradesBadge\" hidden></i></button></div>\n          <form class=\"faddf\" id=\"friendAdd\"><input id=\"friendName\" maxlength=\"16\" placeholder=\"Pseudo de ton ami\" autocomplete=\"off\" autocapitalize=\"off\" spellcheck=\"false\" aria-label=\"Pseudo de ton ami\"><button class=\"btn small\" type=\"submit\">Ajouter</button></form>\n          <ul class=\"friends\" id=\"friends\"><li class=\"muted\">Chargement…</li></ul>\n        </div>\n        <div class=\"card\">\n          <div class=\"cardhead\"><h2>Classement</h2><button class=\"link\" id=\"bRefresh\">Actualiser</button></div>\n          <ol class=\"board\" id=\"board\"><li class=\"muted\">Chargement…</li></ol>\n        </div>\n        <div class=\"card\">\n          <h2>Mes derniers matchs</h2>\n          <ul class=\"recent\" id=\"recent\"><li class=\"muted\">Chargement…</li></ul>\n        </div>\n        <button class=\"link out\" id=\"bLogout\">Se déconnecter</button>\n      </div>\n    </div>\n  </section>\n\n  <!-- Mon équipe -->\n  <section id=\"club\" class=\"screen\" hidden>\n    <header class=\"topbar\">\n      <button class=\"link\" data-home>← Accueil</button>\n      <div class=\"logo\">MON <span>ÉQUIPE</span></div>\n      <span class=\"coins\" id=\"coinsClub\"></span>\n    </header>\n    <div class=\"clubgrid\">\n      <div class=\"col\">\n        <div class=\"card\">\n          <label class=\"lbl\" for=\"tName\">Nom de l'équipe</label>\n          <input class=\"field\" id=\"tName\" maxlength=\"22\" autocomplete=\"off\">\n          <span class=\"lbl\">Maillot</span>\n          <div class=\"kits\" id=\"kitList\"></div>\n        </div>\n        <div class=\"tsum\" id=\"tSum\"></div>\n        <p class=\"err\" id=\"clubErr\" role=\"alert\"></p>\n        <button class=\"btn primary\" id=\"bSaveTeam\">Enregistrer l'équipe</button>\n        <p class=\"hint\">Touche un poste pour choisir un joueur de ta collection. Un poste vide est tenu par un remplaçant noté 64.</p>\n      </div>\n      <div class=\"col\">\n        <div class=\"pitch\" id=\"pitch\"></div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Packs -->\n  <section id=\"shop\" class=\"screen\" hidden>\n    <header class=\"topbar\">\n      <button class=\"link\" data-home>← Accueil</button>\n      <div class=\"logo\">PACK <span>OPENING</span></div>\n      <span class=\"coins\" id=\"coinsShop\"></span>\n    </header>\n    <div class=\"wrap1200\">\n      <div class=\"prog\" id=\"prog\"></div>\n      <nav class=\"tabs\" id=\"shopTabs\"><button data-tab=\"packs\" aria-selected=\"true\">Packs</button><button data-tab=\"coll\" aria-selected=\"false\">Collection</button><button data-tab=\"coins\" aria-selected=\"false\">💶 Pièces</button></nav>\n      <div id=\"shopBody\"></div>\n    </div>\n  </section>\n\n  <!-- Salle -->\n  <section id=\"lobby\" class=\"screen\" hidden>\n    <header class=\"topbar\">\n      <button class=\"link\" id=\"bLeave\">← Quitter la salle</button>\n      <div class=\"code\" id=\"roomCode\"></div>\n      <div class=\"netpill\" id=\"netPill\">Connexion…</div>\n    </header>\n    <div class=\"lobbygrid\">\n      <div class=\"col\">\n        <div class=\"vs\">\n          <div class=\"slot\" id=\"slotMe\"></div>\n          <div class=\"vsx\">VS</div>\n          <div class=\"slot\" id=\"slotOp\"></div>\n        </div>\n        <div class=\"card opts\" id=\"hostOpts\">\n          <span>Mode</span><div class=\"chips\" id=\"modeChips\"></div>\n          <span id=\"durLbl\">Durée</span><div class=\"chips\" id=\"durChips\"></div>\n          <span id=\"dpLbl\" hidden>Pack</span><div class=\"chips\" id=\"dpChips\" hidden></div>\n          <span id=\"drLbl\" hidden>Manches</span><div class=\"chips\" id=\"drChips\" hidden></div>\n        </div>\n        <button class=\"btn primary big\" id=\"bReady\">Je suis prêt</button>\n        <p class=\"hint\" id=\"lobbyHint\"></p>\n      </div>\n      <div class=\"col\">\n        <div class=\"card\"><h2>Choisis ton équipe</h2><div class=\"teams\" id=\"teamGrid\"></div></div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Duel de packs -->\n  <section id=\"pduel\" class=\"screen\" hidden>\n    <div class=\"wrap1200\">\n      <div class=\"dboard\" id=\"dBoard\"></div>\n      <div class=\"dround\" id=\"dRound\"></div>\n      <div class=\"actions\" id=\"dActions\"></div>\n      <div class=\"hist\" id=\"dHist\"></div>\n    </div>\n  </section>\n\n  <!-- Match -->\n  <section id=\"game\" class=\"screen game\" hidden>\n    <canvas id=\"cv\" aria-label=\"Terrain de football\"></canvas>\n    <div class=\"rotate\" id=\"rotate\"><div class=\"phone\"></div><b>Tourne ton écran</b><span>Le match se joue en paysage</span></div>\n    <div class=\"overlay\" id=\"menu\" hidden>\n      <div class=\"box\"><h2>Menu</h2>\n        <button class=\"btn primary\" id=\"bResume\">Reprendre</button>\n        <button class=\"btn\" id=\"bFull\">Plein écran</button>\n        <button class=\"btn\" id=\"bSound\">Son : activé</button>\n        <button class=\"btn\" id=\"bSettings2\">Paramètres</button>\n        <button class=\"btn danger\" id=\"bQuit\">Abandonner le match</button>\n      </div>\n    </div>\n  </section>\n\n  <!-- Fin -->\n  <section id=\"end\" class=\"screen\" hidden>\n    <div class=\"endgrid\">\n      <div class=\"col\">\n        <div id=\"endBoard\"></div>\n        <div id=\"endRating\"></div>\n        <div class=\"actions\" id=\"endActions\"></div>\n      </div>\n      <div class=\"col\">\n        <div id=\"endMvp\"></div>\n        <div class=\"card stats\" id=\"endStats\"></div>\n        <div class=\"lineups\" id=\"endLineups\"></div>\n      </div>\n    </div>\n  </section>\n\n  <div id=\"pack\" class=\"overlay pk\" hidden></div>\n  <div id=\"picker\" class=\"overlay sheet\" hidden></div>\n  <div id=\"tuto\" class=\"overlay tuto\" hidden></div>\n  <div id=\"admin\" class=\"overlay sheet setov profov\" hidden></div>\n  <div id=\"settings\" class=\"overlay sheet setov\" hidden></div>\n  <div id=\"profile\" class=\"overlay sheet setov profov\" hidden></div>\n  <div id=\"chat\" class=\"overlay sheet setov profov\" hidden></div>\n  <div id=\"trade\" class=\"overlay sheet setov profov\" hidden></div>\n  <div id=\"replay\" class=\"overlay rpov\" hidden></div>\n  <div class=\"toast\" id=\"toast\" role=\"status\"></div>\n</div>\n<script type=\"module\" src=\"v/5a346f9bcb35bd2cf528128e95a42f4ed95481bd/app.js\"></script>\n</body>\n</html>\n"}]}